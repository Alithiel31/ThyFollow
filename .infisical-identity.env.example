# Identité Infisical utilisée par deploy.sh (Machine Identity "thyrotrack-deploy",
# rôle Viewer, Universal Auth). Copier en ".infisical-identity.env" (ignoré par git)
# et remplacer les valeurs. Ne JAMAIS committer le vrai fichier : il contient un
# secret, et le vrai nom du tailnet dans INFISICAL_API_URL (le dépôt est public).
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID="changeme"
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET="changeme"
INFISICAL_API_URL="http://caesura.<tailnet>.ts.net:8090/api"
INFISICAL_PROJECT_ID="changeme"
# Environnement Infisical (Production = "prod"). Facultatif, "prod" par défaut.
# INFISICAL_ENV="prod"
