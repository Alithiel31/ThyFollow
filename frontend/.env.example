# frontend/.env.example
# En développement, le proxy Vite redirige /api vers le backend
# En production, le backend sert le frontend directement (pas besoin)

VITE_APP_NAME=ThyroTrack

# Sentry (suivi d'erreurs en production). Laisser vide désactive proprement
# l'intégration. Rappel : les variables VITE_* sont figées au build (Vite),
# pas lues au démarrage du conteneur — voir le build arg VITE_SENTRY_DSN
# dans docker-compose.yml pour le déploiement Docker.
VITE_SENTRY_DSN=
