# Variables lues par docker-compose.yml à la racine du projet.
# Copier en ".env" et renseigner un mot de passe fort (ex: openssl rand -hex 24).

POSTGRES_PASSWORD="change-me-strong-random-value"

# Sentry (suivi d'erreurs frontend) — figé dans le bundle statique au build
# de l'image frontend (voir frontend/Dockerfile). Laisser vide désactive
# proprement l'intégration.
VITE_SENTRY_DSN=""
