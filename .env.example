# Variables lues par docker-compose.yml à la racine du projet.
# Copier en ".env" et renseigner le mot de passe du rôle thyrotrack_app
# sur l'instance Postgres partagée (ex: openssl rand -hex 24).
#
# En production sur Caesura, ces valeurs ne sont PAS lues ici : deploy.sh les
# injecte depuis Infisical (DB_PASSWORD <- PG_THYROTRACK_PASSWORD,
# PDF_ENCRYPTION_KEY, ANTHROPIC_API_KEY). Ce fichier ne sert qu'à un déploiement
# sans Infisical.

DB_PASSWORD="change-me-strong-random-value"

# Import de bilans sanguins PDF (facultatif — laisser vide désactive la fonctionnalité).
# Clé de chiffrement des PDF stockés et des mots de passe de PDF mémorisés
# (64 caractères hexadécimaux). Générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# À sauvegarder ailleurs : perdue, tous les PDF stockés deviennent illisibles.
PDF_ENCRYPTION_KEY=""
# Clé API Anthropic pour le repli d'extraction par IA (opt-in par utilisateur).
ANTHROPIC_API_KEY=""
