# Backend environment variables
# Copy to .env and fill in your values

# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/thyrotrack"

# Auth
# Minimum 32 caractères en production, sinon le serveur refuse de démarrer.
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="30d"

# OpenID Connect / OAuth2 — "Se connecter avec Google"
# À créer dans Google Cloud Console > APIs & Services > Credentials.
# Laisser vide désactive proprement la fonctionnalité (501).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Doit être déclarée telle quelle comme "Authorized redirect URI" côté Google.
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/oidc/google/callback"

# Google Health API — synchronisation poids/rythme cardiaque/sommeil depuis
# un appareil connecté (Pixel Watch...). Distinct de GOOGLE_CLIENT_ID/SECRET
# ci-dessus (scopes sensibles, projet Google Cloud dédié recommandé).
# Laisser vide désactive proprement la fonctionnalité (501).
GOOGLE_HEALTH_CLIENT_ID=""
GOOGLE_HEALTH_CLIENT_SECRET=""
GOOGLE_HEALTH_REDIRECT_URI="http://localhost:3001/api/integrations/google-health/callback"
# Clé de chiffrement (64 caractères hexadécimaux = 32 octets) des tokens
# Google Health stockés en base. Générer avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Requise dès que GOOGLE_HEALTH_CLIENT_ID est renseigné.
TOKEN_ENCRYPTION_KEY=""

# Import de bilans sanguins PDF — clé de chiffrement (64 caractères
# hexadécimaux) des PDF stockés et des mots de passe de PDF mémorisés. DISTINCTE
# de TOKEN_ENCRYPTION_KEY. Générer avec la même commande que ci-dessus.
# Laisser vide désactive proprement l'import (501).
PDF_ENCRYPTION_KEY=""
PDF_ENCRYPTION_KEY_VERSION="1"
# Extraction LLM de repli (opt-in par utilisateur, texte anonymisé uniquement).
# Laisser vide désactive le repli ; l'extraction par règles reste active.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"
# Limites de l'import par lot
PDF_IMPORT_MAX_FILES="10"
PDF_IMPORT_MAX_BYTES="10485760"

# Abonné webhook Google Health (synchro automatique en arrière-plan) — au
# niveau du projet Google Cloud, géré via un compte de service IAM dédié.
# Voir le README ("Synchroniser Google Health") pour la procédure complète.
# Numéro (PAS l'ID) du projet Google Cloud.
GOOGLE_HEALTH_PROJECT_NUMBER=""
# Contenu JSON complet de la clé du compte de service (pas un chemin de
# fichier) — rôle minimum requis : "Éditeur de l'API Google Health".
GOOGLE_HEALTH_SERVICE_ACCOUNT_KEY=""
# Secret choisi par vous, renvoyé tel quel par Google dans l'en-tête
# Authorization de chaque notification webhook. Générer par exemple avec :
# node -e "console.log('Bearer ' + require('crypto').randomBytes(24).toString('hex'))"
GOOGLE_HEALTH_WEBHOOK_SECRET=""

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# URL publique canonique du frontend (utilisée dans les liens envoyés par email)
APP_URL="http://localhost:5173"

# Resend (email de confirmation d'inscription)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="ThyroTrack <noreply@votredomaine.com>"

# Abonnement Pro (facultatif — sans ces trois valeurs, pas de paiement par carte ;
# les codes promo et l'accès ADMIN fonctionnent quand même).
# Dashboard Stripe : clé secrète, produit récurrent (STRIPE_PRICE_ID = price_...)
# et endpoint webhook https://<votre-domaine>/api/webhooks/stripe abonné aux
# évènements checkout.session.completed et customer.subscription.created / updated / deleted.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
# Imports de bilans PDF : essai gratuit (à vie) et plafond mensuel des comptes Pro.
FREE_IMPORT_LIMIT=3
PRO_MONTHLY_IMPORT_LIMIT=25
